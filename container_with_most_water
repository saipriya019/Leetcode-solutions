class Solution {
public:
    int maxArea(vector<int>& height) {
        int lp=0;
        int rp=height.size()-1;
        int MaxWater=0;
        while(lp<rp){
            int width=rp-lp;
            int ht=min(height[lp],height[rp]);
            int CurrWater=width*ht;
            MaxWater=max(CurrWater,MaxWater);
            if(height[lp]<height[rp]){
                lp++;
            }
            else{
                rp--;
            }
        }
        return MaxWater;
        

            
    }
    
};
