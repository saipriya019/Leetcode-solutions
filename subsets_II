class Solution {
public:
    void subset(int ind,vector<int> &ds,vector<int> &nums,vector<vector<int>> &ans){
        ans.push_back(ds);
        for(int i=ind;i<nums.size();i++){
            if(i>ind && nums[i]==nums[i-1]){
                continue;
            }
            ds.push_back(nums[i]);
            subset(i+1,ds,nums,ans);
            ds.pop_back();
        }


    }
    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        vector<int>ds;
        vector<vector<int>>ans;
        subset(0,ds,nums,ans);
        return ans;
    }
};
