class Solution {
public:
    int searchInsert(vector<int>& nums, int target) { 
        int k=nums.size();
        for( int i=0;i<nums.size();i++){
            if(nums[i]==target){
                return i;
            } 
            if(nums[i]>target){
                return i;
            }
            if(nums[k-1]<target){
                return k;
            }
        }   
        return 0;
     
        
        
    }
};
